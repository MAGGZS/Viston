# =============================================================================
# VISTON FRONTEND — VARIÁVEIS DE AMBIENTE
# =============================================================================
#
# NADA AQUI É OBRIGATÓRIO.
#
# A URL da API é resolvida sozinha em app/lib/api.js:
#   - página servida de localhost  -> http://localhost:4000  (backend local)
#   - qualquer outro host          -> https://viston.onrender.com (Render)
#
# Ou seja: rodar local e na nuvem não exige trocar nada.
#
# Defina NEXT_PUBLIC_API_URL apenas para sobrescrever essa lógica, por exemplo
# para rodar o frontend local contra a API de produção. Nesse caso, a origem
# http://localhost:3001 precisa estar no FRONTEND_URL do backend no Render.
#
# NEXT_PUBLIC_API_URL="https://viston.onrender.com"

# -----------------------------------------------------------------------------
# URL PÚBLICA DO SITE
# -----------------------------------------------------------------------------
# Usada em canonical, Open Graph, sitemap.xml e robots.txt.
# Sem ela o build assume https://viston.vercel.app.
# NEXT_PUBLIC_SITE_URL="https://viston.vercel.app"
