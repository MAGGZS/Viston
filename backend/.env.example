# =============================================================================
# VISTON BACKEND — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local (desenvolvimento) ou .env (produção)
# NUNCA commite .env.local ou .env com valores reais
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# LOCAL (Supabase CLI ou Docker Postgres):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=public"
# PRODUÇÃO (Supabase pooling/PgBouncer — obrigatório no Render):
#   DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=public"
# DIRECT_URL é necessário para migrations (sem pooling — URL direta)
# PRODUÇÃO: URL direta do Supabase (porta 5432, sem ?pgbouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres?schema=public"

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# LOCAL (Supabase CLI — rode `supabase start` para obter):
#   SUPABASE_URL="http://localhost:54321"
#   SUPABASE_SERVICE_ROLE_KEY="<chave gerada pelo supabase start>"
# PRODUÇÃO:
#   SUPABASE_URL="https://[PROJECT_REF].supabase.co"
#   SUPABASE_SERVICE_ROLE_KEY="<service_role key do painel Supabase>"
SUPABASE_URL="http://localhost:54321"
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# Nomes dos buckets no Supabase Storage (criar manualmente ou via seed)
SUPABASE_BUCKET_PHOTOS="viston-photos"
SUPABASE_BUCKET_EXCEL="viston-excel"

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# GOOGLE FORMS
# -----------------------------------------------------------------------------
# LOCAL: use um Google Forms de teste (não o de produção)
# PRODUÇÃO: URL real do formulário (.../formResponse)
# Formato: https://docs.google.com/forms/d/e/FORM_ID/formResponse
GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse"

# IDs dos campos do Google Forms (entry.XXXXXXX)
# Obtenha inspecionando o HTML do formulário ou via Google Forms API
GOOGLE_FORM_FIELD_ITEM_NAME="entry.111111"
GOOGLE_FORM_FIELD_QUANTITY="entry.222222"
GOOGLE_FORM_FIELD_IS_MARKED="entry.333333"
GOOGLE_FORM_FIELD_STATUS="entry.444444"
GOOGLE_FORM_FIELD_OBSERVATION="entry.555555"

# -----------------------------------------------------------------------------
# SERVIDOR
# -----------------------------------------------------------------------------
# 4000 para não colidir com o Next (frontend roda na 3001)
PORT=4000
NODE_ENV="development"

# -----------------------------------------------------------------------------
# CORS — FRONTEND
# -----------------------------------------------------------------------------
# Aceita uma ou VÁRIAS origens separadas por vírgula (sem espaço obrigatório).
# LOCAL: URL do frontend rodando localmente
# PRODUÇÃO: URL da Vercel + (opcional) localhost para desenvolver contra a API da nuvem
#   FRONTEND_URL="https://viston.vercel.app,http://localhost:3001"
FRONTEND_URL="http://localhost:3001"

# =============================================================================
# CHECKLIST DE TROCA PARA PRODUÇÃO (sem alteração de código)
# =============================================================================
# 1. DATABASE_URL     → URL pooling do Supabase (com ?pgbouncer=true&connection_limit=1)
# 1b. DIRECT_URL      → URL direta do Supabase (porta 5432, sem pgbouncer — para migrations)
# 2. SUPABASE_URL     → https://[PROJECT_REF].supabase.co
# 3. SUPABASE_SERVICE_ROLE_KEY → service_role key do painel Supabase > Settings > API
# 4. JWT_SECRET       → string aleatória longa (mín. 64 chars)
# 5. JWT_REFRESH_SECRET → string aleatória longa diferente do JWT_SECRET
# 6. GOOGLE_FORM_URL  → URL real do formulário de produção
# 7. GOOGLE_FORM_FIELD_* → IDs reais dos campos do formulário de produção
# 8. FRONTEND_URL     → URL da Vercel (ex: https://viston.vercel.app)
# 9. NODE_ENV         → "production"
# =============================================================================
