generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  INSPECTOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum ItemStatus {
  OK
  NOK
  NA
}

enum FloorGeneralStatus {
  OK
  ATENCAO
  PROBLEMA
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         Role       @default(INSPECTOR)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  inspections InspectionReport[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Building {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  floors      Floor[]
  inspections InspectionReport[]

  @@map("buildings")
}

model Floor {
  id         String  @id @default(uuid())
  buildingId String  @map("building_id")
  label      String
  number     Int
  order      Int

  building   Building         @relation(fields: [buildingId], references: [id])
  formEntries FloorFormEntry[]

  @@map("floors")
}

model InspectionReport {
  id              String           @id @default(uuid())
  inspectorId     String           @map("inspector_id")
  buildingId      String           @map("building_id")
  date            DateTime         @db.Date
  startedAt       DateTime         @map("started_at")
  finishedAt      DateTime?        @map("finished_at")
  floorsInspected String[]         @map("floors_inspected")
  status          InspectionStatus @default(IN_PROGRESS)
  pdfUrl          String?          @map("pdf_url")
  excelUrl        String?          @map("excel_url")
  createdAt       DateTime         @default(now()) @map("created_at")

  inspector   User             @relation(fields: [inspectorId], references: [id])
  building    Building         @relation(fields: [buildingId], references: [id])
  floorEntries FloorFormEntry[]

  @@map("inspection_reports")
}

model FloorFormEntry {
  id            String             @id @default(uuid())
  reportId      String             @map("report_id")
  floorId       String             @map("floor_id")
  statusGeral   FloorGeneralStatus @map("status_geral")
  notes         String?
  photos        String[]
  completedAt   DateTime?          @map("completed_at")

  report      InspectionReport   @relation(fields: [reportId], references: [id])
  floor       Floor              @relation(fields: [floorId], references: [id])
  items       FormItemResponse[]

  @@map("floor_form_entries")
}

model FormItemResponse {
  id           String     @id @default(uuid())
  floorEntryId String     @map("floor_entry_id")
  itemName     String     @map("item_name")
  status       ItemStatus
  observation  String?

  floorEntry FloorFormEntry @relation(fields: [floorEntryId], references: [id])

  @@map("form_item_responses")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
