// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

/// O que a conta é no sistema, e só isso.
///
/// ADMIN é a conta de suporte: enxerga tudo, administra contas, não tem prédio.
/// NONE é todo o resto — inclusive quem gere um prédio. Poder sobre prédio não
/// mora aqui; mora em `BuildingMember` (ver `BuildingRole`).
enum AccountRole {
  ADMIN
  NONE
}

/// O que a pessoa é dentro de um prédio específico.
///
/// É a única fonte de atribuição do produto: a mesma conta pode ser GESTOR de um
/// prédio, INSPECTOR de outro e não existir num terceiro.
enum BuildingRole {
  // Administra o prédio: andares, colaboradores, solicitações e descarte de vistoria.
  GESTOR
  // Vistoria o prédio.
  INSPECTOR
  // Só acompanha o que já foi vistoriado.
  VIEWER
}

enum UserStatus {
  ACTIVE
  DELETED
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum FloorStatus {
  OK
  ATENCAO
  PROBLEMA
}

enum MaintenanceType {
  AR_CONDICIONADO
  CIVIL
  ELETRICA
  EQUIPAMENTO
  EVENTOS
  HIDRELETRICA
  HIGIENIZACAO_LIMPEZA
  INFILTRACAO
  MARCENARIA
  MOVEIS_CADEIRAS
  PINTURA
  PROJETOR
  VAZAMENTO
}

enum MaintenanceCategory {
  PREVENTIVA
  CORRETIVA
  EMERGENCIAL
  EVENTOS
  PROJETOS
}

enum Priority {
  ALTA
  MEDIA
  BAIXA
}

enum RecordStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_TERCEIRO
  CONCLUIDO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SYNC_GOOGLE_FORM
  SYNC_GOOGLE_FORM_FAILED
  FINISH_INSPECTION
  GENERATE_EXCEL
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password_hash String
  role          AccountRole @default(NONE)
  avatar_url    String?
  status        UserStatus  @default(ACTIVE)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  inspections     InspectionReport[]
  audit_logs      AuditLog[]
  created_buildings Building[]             @relation("BuildingCreator")
  building_members  BuildingMember[]       @relation("BuildingMembers")
  access_requests   BuildingAccessRequest[] @relation("BuildingAccessRequests")

  @@map("users")
}

model Building {
  id          String  @id @default(uuid())
  name        String
  description String?
  share_key   String  @unique
  // Histórico de auditoria: quem cadastrou o prédio. Não autoriza nada — quem
  // administra está em `members` com role GESTOR. Fica nulo se a conta sumir.
  created_by  String?

  creator     User?                  @relation("BuildingCreator", fields: [created_by], references: [id], onDelete: SetNull)
  floors      Floor[]
  inspections InspectionReport[]
  members     BuildingMember[]
  access_requests BuildingAccessRequest[]
  audit_logs  AuditLog[]

  @@map("buildings")
}

/// O vínculo entre uma pessoa e um prédio — e o papel dela ali dentro.
///
/// Toda autorização de prédio passa por esta tabela. Um prédio pode ter mais de
/// um GESTOR, e a gestão se transfere trocando o papel do vínculo.
model BuildingMember {
  id          String       @id @default(uuid())
  building_id String
  user_id     String
  role        BuildingRole
  joined_at   DateTime     @default(now())

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  user     User     @relation("BuildingMembers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([building_id, user_id])
  @@index([user_id])
  @@map("building_members")
}

model BuildingAccessRequest {
  id          String    @id @default(uuid())
  building_id String
  user_id     String
  status      String    @default("PENDING")
  requested_at DateTime @default(now())
  reviewed_at  DateTime?

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  user     User     @relation("BuildingAccessRequests", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([building_id, user_id])
  @@map("building_access_requests")
}

model Floor {
  id          String  @id @default(uuid())
  building_id String
  label       String

  building          Building           @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_form_entries FloorFormEntry[]

  @@unique([building_id, label])
  @@map("floors")
}

model InspectionReport {
  id                    String           @id @default(uuid())
  inspector_id          String?
  building_id           String
  date                  DateTime         @db.Date
  started_at            DateTime         @default(now())
  finished_at           DateTime?
  floors_inspected      String[]
  status                InspectionStatus @default(IN_PROGRESS)
  excel_url             String?
  google_form_synced    Boolean          @default(false)
  google_form_synced_at DateTime?
  created_at            DateTime         @default(now())

  inspector          User?            @relation(fields: [inspector_id], references: [id], onDelete: SetNull)
  building           Building         @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_form_entries FloorFormEntry[]

  @@map("inspection_reports")
}

model FloorFormEntry {
  id           String      @id @default(uuid())
  report_id    String
  floor_id     String
  status_geral FloorStatus
  completed_at DateTime    @default(now())

  report              InspectionReport    @relation(fields: [report_id], references: [id], onDelete: Cascade)
  floor               Floor               @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  maintenance_records MaintenanceRecord[]

  @@unique([report_id, floor_id])
  @@map("floor_form_entries")
}

// Uma ocorrência relatada em um andar. O mesmo andar pode ter várias.
model MaintenanceRecord {
  id                  String              @id @default(uuid())
  floor_form_entry_id String
  maintenance_type    MaintenanceType
  category            MaintenanceCategory
  priority            Priority
  description         String
  responsible         String
  status              RecordStatus        @default(ABERTO)
  created_at          DateTime            @default(now())

  floor_form_entry FloorFormEntry @relation(fields: [floor_form_entry_id], references: [id], onDelete: Cascade)

  @@map("maintenance_records")
}

model AuditLog {
  id        String      @id @default(uuid())
  user_id   String?
  // Prédio a que o registro pertence, quando houver: é o que permite ao gestor
  // ver a trilha do prédio dele em vez da do sistema inteiro. Login, logout e
  // mexida em conta não têm prédio, e ficam nulos.
  building_id String?
  action    AuditAction
  entity    String?
  entity_id String?
  metadata  Json?
  timestamp DateTime    @default(now())

  user     User?     @relation(fields: [user_id], references: [id])
  building Building? @relation(fields: [building_id], references: [id], onDelete: SetNull)

  @@index([building_id])
  @@map("audit_logs")
}
