// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

/// O que a conta é no sistema, e só isso.
///
/// ADMIN é a conta de suporte: enxerga tudo, administra contas, não tem prédio.
/// NONE é todo o resto — inclusive quem gere um prédio. Poder sobre prédio não
/// mora aqui; mora em `BuildingMember` (ver `BuildingRole`).
enum AccountRole {
  ADMIN
  NONE
}

/// O que um usuário comum é dentro de um prédio específico.
///
/// Gestor não está aqui: ele é outro tipo de conta (ver `Manager`), e o vínculo
/// dele com o prédio mora em `BuildingManager`. A mesma conta de usuário pode
/// ser INSPECTOR de um prédio e VIEWER de outro.
enum BuildingRole {
  // Vistoria o prédio.
  INSPECTOR
  // Só acompanha o que já foi vistoriado.
  VIEWER
  // Recebe os chamados abertos pelas vistorias, encaminha ao responsável e é o
  // único que fecha um chamado.
  MODERADOR
  // Técnico alocado no prédio. Atende o chamado encaminhado e informa quando
  // terminou — informar não fecha nada, quem fecha é o moderador.
  RESPONSAVEL
}

enum UserStatus {
  ACTIVE
  DELETED
}

/// Onde o feedback está na caixa do admin.
///
/// PENDENTE é o que acabou de chegar e ninguém leu. Dali ele só sai por decisão
/// do admin: vira TAREFA (algo a fazer), vira MENSAGEM (elogio ou recado, que
/// só se lê) ou é descartado — e descartar apaga a linha, não guarda um quarto
/// estado. Feedback descartado não tem para que servir depois.
enum FeedbackStatus {
  PENDENTE
  TAREFA
  MENSAGEM
}

enum InspectionStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReportOrigin {
  VISTORIA
  AVULSA
}

enum FloorStatus {
  OK
  ATENCAO
  PROBLEMA
}

enum MaintenanceType {
  AR_CONDICIONADO
  CIVIL
  ELETRICA
  EQUIPAMENTO
  EVENTOS
  HIDRELETRICA
  HIGIENIZACAO_LIMPEZA
  INFILTRACAO
  MARCENARIA
  MOVEIS_CADEIRAS
  PINTURA
  PROJETOR
  VAZAMENTO
}

enum MaintenanceCategory {
  PREVENTIVA
  CORRETIVA
  EMERGENCIAL
  EVENTOS
  PROJETOS
}

enum Priority {
  ALTA
  MEDIA
  BAIXA
}

/// Onde o chamado está no caminho entre a vistoria e o fechamento.
///
/// ABERTO é o chamado recém-nascido da vistoria: ninguém foi encaminhado ainda,
/// e é o que a tela de novos chamados do moderador lista. Encaminhar leva a
/// ENCAMINHADO, e não a EM_ANDAMENTO: encaminhar não é começar, e o chamado
/// espera ali até o responsável confirmar que o recebeu. AGUARDANDO_FECHAMENTO
/// é o responsável dizendo "terminei" — o chamado continua aberto, porque só o
/// moderador o encerra em CONCLUIDO.
enum RecordStatus {
  ABERTO
  ENCAMINHADO
  EM_ANDAMENTO
  AGUARDANDO_TERCEIRO
  AGUARDANDO_FECHAMENTO
  CONCLUIDO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  SYNC_GOOGLE_FORM
  SYNC_GOOGLE_FORM_FAILED
  FINISH_INSPECTION
  GENERATE_EXCEL
  // Conceder, revogar e congelar mudam o que uma conta pode fazer. Sem data e
  // dono, "por que este prédio parou" não tem resposta.
  PLAN_GRANTED
  PLAN_REVOKED
  SUBSCRIPTION_UPDATED
  BUILDING_FROZEN
}

/// Qual plano a conta tem — e só isso.
///
/// O que cada plano permite mora no código (`src/utils/plans.ts`), nunca no
/// banco. Limite é regra de produto: muda com o produto, e não tem por que
/// exigir migration nem ficar editável por quem alcança o banco.
enum PlanCode {
  LIVRE
  ESSENCIAL
  PRO
}

/// O status da assinatura no Stripe, com os nomes que chegam no webhook.
///
/// Traduzir os nomes aqui só criaria um dicionário a manter, errado no dia em
/// que o Stripe acrescentasse um estado. Os três que dão acesso são TRIALING,
/// ACTIVE e PAST_DUE — o último de propósito: a cobrança falhou e o Stripe vai
/// tentar de novo por alguns dias, e cortar o produto no primeiro cartão
/// recusado castiga quem só trocou de cartão.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique
  password_hash     String
  role              AccountRole @default(NONE)
  avatar_url        String?
  status            UserStatus  @default(ACTIVE)
  /// Geração das sessões desta conta. O refresh token carrega o número que
  /// valia quando foi emitido; incrementar aqui derruba todos os que já
  /// existem — é o que faz sair, trocar de senha e excluir a conta valerem de
  /// verdade, em vez de só apagar o token do navegador de quem saiu.
  token_version     Int         @default(0)
  /// Identificador do último refresh token emitido, para rotação e detecção de reuso.
  refresh_token_jti String?
  /// Quando o dono do endereço provou ser o dono, clicando no link enviado.
  ///
  /// Nulo é conta que existe e não entra: o login para no 403 depois de
  /// conferir a senha (ver `authService.login`).
  email_verified_at DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  email_tokens     EmailToken[]
  inspections      InspectionReport[]
  audit_logs       AuditLog[]
  granted_plans    PlanGrant[]             @relation("PlanGrantedBy")
  building_members BuildingMember[]        @relation("BuildingMembers")
  access_requests  BuildingAccessRequest[] @relation("BuildingAccessRequests")
  feedbacks        Feedback[]
  assigned_records MaintenanceRecord[]     @relation("RecordResponsible")
  closed_records   MaintenanceRecord[]     @relation("RecordClosedBy")
  ticket_updates   TicketUpdate[]          @relation("TicketUpdateAuthor")

  @@map("users")
}

/// A conta de gestor. Vive fora de `users` de propósito.
///
/// Gestor não é um usuário com uma marca a mais: é outro tipo de conta, com
/// cadastro próprio, e estar nesta tabela já é o papel — por isso não existe
/// coluna `role` aqui.
///
/// O que ele não é: inspetor. `inspection_reports.inspector_id` aponta para
/// `users`, e o gestor não está lá; quem administra prédio não vistoria. Para
/// vistoriar, a pessoa precisa de uma conta comum, com outro e-mail.
///
/// O e-mail é único aqui e em `users`, e a checagem cruzada é da aplicação
/// (Postgres não faz unique entre tabelas) — ver `accountRepository.findByEmail`.
model Manager {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  password_hash     String
  avatar_url        String?
  status            UserStatus @default(ACTIVE)
  /// Mesma geração de sessões da conta de usuário — ver `User.token_version`.
  token_version     Int        @default(0)
  /// Identificador do último refresh token emitido, para rotação e detecção de reuso.
  refresh_token_jti String?
  /// Mesma confirmação da conta de usuário — ver `User.email_verified_at`.
  /// Gestor não tem passe livre: cadastro de gestor também é público.
  email_verified_at DateTime?
  /// Conta suspensa pelo admin. Diferente de `status = DELETED`: a conta existe,
  /// os prédios dela existem, e voltar é tirar a data.
  suspended_at      DateTime?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  email_tokens      EmailToken[]
  created_buildings Building[]        @relation("BuildingCreator")
  /// Os prédios que esta conta paga — ver `Building.owner_manager_id`.
  owned_buildings   Building[]        @relation("BuildingOwner")
  managed_buildings BuildingManager[]
  audit_logs        AuditLog[]
  feedbacks         Feedback[]
  subscription      Subscription?
  plan_grants       PlanGrant[]
  usage_counters    UsageCounter[]
  transfers_sent    BuildingOwnershipTransfer[] @relation("TransferFrom")
  transfers_received BuildingOwnershipTransfer[] @relation("TransferTo")

  @@map("managers")
}

/// Para que o código serve. Ver o comentário da migration `otp_e_recuperacao`.
enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

/// O código de 6 dígitos enviado por e-mail, guardado como hash.
///
/// O valor legível vive só dentro da mensagem: aqui fica `sha256` dele. Quem
/// ler o banco inteiro não confirma conta nem troca senha de ninguém.
///
/// Dois donos possíveis porque o sistema tem duas tabelas de conta. Exatamente
/// uma das duas colunas é preenchida — o CHECK `email_tokens_one_owner`, na
/// migration, é quem garante isso; o Prisma não modela CHECK.
model EmailToken {
  id                    String       @id @default(uuid())
  purpose               TokenPurpose @default(EMAIL_VERIFY)
  user_id               String?
  manager_id            String?
  /// O endereço para onde o código foi. Guardado à parte da conta porque é por
  /// ele que o teto de envios por hora conta, antes mesmo de saber quem é.
  email                 String
  code_hash             String?
  /// Hash da senha enviada num segundo cadastro enquanto a conta ainda não foi
  /// confirmada; só vai para a conta quando o código correspondente é validado.
  pending_password_hash String?
  expires_at            DateTime
  /// Chutes errados. No quinto o registro morre — é isto, e não o prazo, que
  /// torna a força bruta inviável contra seis dígitos.
  attempts              Int          @default(0)
  /// Carimbado no consumo e também quando um código novo é emitido: só o mais
  /// recente vale. Nulo é o único estado em que o código ainda abre.
  used_at               DateTime?
  created_at            DateTime     @default(now())

  user    User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  manager Manager? @relation(fields: [manager_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([manager_id])
  @@index([email, purpose, used_at, created_at(sort: Desc)], map: "email_tokens_lookup_idx")
  @@map("email_tokens")
}

model Building {
  id          String  @id @default(uuid())
  name        String
  description String?
  share_key   String  @unique
  // Histórico de auditoria: qual gestor cadastrou o prédio. Não autoriza nada —
  // quem administra está em `managers`. Fica nulo se a conta sumir.
  created_by  String?
  /// Quem paga por este prédio.
  ///
  /// Nasce apontando para quem o criou. O prédio tem vários gestores (ver
  /// `BuildingManager`), mas um só dono: sem isso, "de quem é a cobrança" não
  /// teria resposta. Não autoriza nada — o poder continua vindo do vínculo.
  ///
  /// Nulo é o prédio cujo dono sumiu: ele não some junto, fica sem dono até o
  /// admin ou uma transferência resolver.
  owner_manager_id String?
  /// Prédio inativo: continua existindo e não aceita mais trabalho.
  ///
  /// É o destino de quem estourou o plano e não regularizou, e do prédio cuja
  /// transferência de dono ninguém aceitou. Nulo é prédio normal.
  frozen_at   DateTime?

  creator         Manager?                @relation("BuildingCreator", fields: [created_by], references: [id], onDelete: SetNull)
  owner           Manager?                @relation("BuildingOwner", fields: [owner_manager_id], references: [id], onDelete: SetNull)
  floors          Floor[]
  inspections     InspectionReport[]
  managers        BuildingManager[]
  members         BuildingMember[]
  access_requests BuildingAccessRequest[]
  audit_logs      AuditLog[]
  share_tokens    BuildingShareToken[]
  photo_assets    PhotoAsset[]
  ownership_transfers BuildingOwnershipTransfer[]

  // "Os prédios desta conta" é a pergunta de toda contagem de limite.
  @@index([owner_manager_id])
  @@map("buildings")
}

/// Tokens temporários de compartilhamento do prédio (validade de 15 minutos).
/// Alimentam o QR Code, link direto e código rotativo exibidos pelo gestor.
model BuildingShareToken {
  id          String   @id @default(uuid())
  building_id String
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  building    Building @relation(fields: [building_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([building_id, expires_at])
  @@map("building_share_tokens")
}

/// Quem administra o prédio.
///
/// Tabela de ligação, e não uma coluna `manager_id` no prédio, por dois motivos
/// que já custaram caro: com uma coluna só, o prédio tem no máximo um gestor, e
/// transferir a gestão exigiria reescrever quem o criou — que é dado de
/// auditoria. Aqui, dois gestores é um estado válido e a transferência é
/// promover o outro e sair.
///
/// Um prédio nunca fica sem nenhum: a aplicação recusa com 409 e o banco tem
/// gatilho (ver a migration `manager_accounts`).
model BuildingManager {
  id          String   @id @default(uuid())
  building_id String
  manager_id  String
  joined_at   DateTime @default(now())

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  manager  Manager  @relation(fields: [manager_id], references: [id], onDelete: Cascade)

  @@unique([building_id, manager_id])
  @@index([manager_id])
  @@map("building_managers")
}

/// O vínculo entre um usuário comum e um prédio.
///
/// Só INSPECTOR e VIEWER: gestor não aparece aqui, porque gestor não é usuário.
model BuildingMember {
  id          String       @id @default(uuid())
  building_id String
  user_id     String
  role        BuildingRole
  joined_at   DateTime     @default(now())

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  user     User     @relation("BuildingMembers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([building_id, user_id])
  @@index([user_id])
  @@map("building_members")
}

model BuildingAccessRequest {
  id           String    @id @default(uuid())
  building_id  String
  user_id      String
  status       String    @default("PENDING")
  requested_at DateTime  @default(now())
  reviewed_at  DateTime?

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  user     User     @relation("BuildingAccessRequests", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([building_id, user_id])
  @@map("building_access_requests")
}

model Floor {
  id          String @id @default(uuid())
  building_id String
  label       String

  building           Building         @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_form_entries FloorFormEntry[]

  @@unique([building_id, label])
  @@map("floors")
}

model InspectionReport {
  id                    String           @id @default(uuid())
  inspector_id          String?
  building_id           String
  date                  DateTime         @db.Date
  started_at            DateTime         @default(now())
  finished_at           DateTime?
  floors_inspected      String[]
  status                InspectionStatus @default(IN_PROGRESS)
  origin                ReportOrigin     @default(VISTORIA)
  /// Identifica a *tentativa* de envio, não o relatório.
  ///
  /// O app gera a chave quando a vistoria começa e a manda no cabeçalho
  /// `Idempotency-Key`. Reenviar com a mesma chave devolve o relatório que já
  /// foi criado, em vez de criar um segundo — que é o que acontecia com toque
  /// duplo ou retry de rede. Nula no que foi enviado antes disto existir.
  submission_key        String?          @unique
  /// Caminho do objeto no bucket, não a URL.
  ///
  /// O bucket é privado: a URL é assinada na hora do download (ver
  /// `storageService.createExcelSignedUrl`) e dura minutos. Guardar a URL aqui
  /// era guardar um acesso permanente e sem autenticação ao relatório — que a
  /// API nega a quem não tem vínculo com o prédio.
  excel_path            String?
  google_form_synced    Boolean          @default(false)
  google_form_synced_at DateTime?
  created_at            DateTime         @default(now())

  inspector          User?            @relation(fields: [inspector_id], references: [id], onDelete: SetNull)
  building           Building         @relation(fields: [building_id], references: [id], onDelete: Cascade)
  floor_form_entries FloorFormEntry[]

  // Histórico do prédio e calendário: os dois filtram por prédio e ordenam (ou
  // recortam a faixa) por `finished_at`.
  @@index([building_id, finished_at(sort: Desc)])
  // "Vistorias que passaram por este andar" filtra um array de texto. Sem GIN é
  // varredura da tabela inteira, e o custo cresce em linha reta com a base.
  @@index([floors_inspected], type: Gin)
  @@map("inspection_reports")
}

model FloorFormEntry {
  id           String      @id @default(uuid())
  report_id    String
  floor_id     String
  status_geral FloorStatus
  completed_at DateTime    @default(now())

  report              InspectionReport    @relation(fields: [report_id], references: [id], onDelete: Cascade)
  floor               Floor               @relation(fields: [floor_id], references: [id], onDelete: Cascade)
  maintenance_records MaintenanceRecord[]

  @@unique([report_id, floor_id])
  @@map("floor_form_entries")
}

/// Uma ocorrência relatada em um andar — e, a partir dela, o chamado.
///
/// O mesmo andar pode ter várias. A ocorrência nasce ABERTA na vistoria e a
/// partir daí a linha é o chamado: o moderador encaminha a um responsável, o
/// responsável informa que terminou, o moderador fecha. As datas guardam cada
/// um desses passos porque o status sozinho não diz quando nada aconteceu.
///
/// `responsible_id` e `responsible` convivem de propósito. O id é o vínculo
/// vivo, e é por ele que o responsável enxerga o que é dele; o nome é o que
/// ficou gravado quando a ocorrência foi criada, e é o que o relatório antigo
/// mostra depois que a conta some (o vínculo é SetNull). Os dois nulos é o
/// chamado que ainda não tem dono.
model MaintenanceRecord {
  id                  String              @id @default(uuid())
  floor_form_entry_id String
  maintenance_type    MaintenanceType
  category            MaintenanceCategory
  priority            Priority
  description         String
  /// Nome do responsável no momento em que a ocorrência foi registrada.
  responsible         String?
  responsible_id      String?
  status              RecordStatus        @default(ABERTO)
  /// Quando o moderador encaminhou o chamado. Nulo = chamado novo.
  forwarded_at        DateTime?
  /// Quando o responsável confirmou o recebimento. Nulo = ainda aguarda aceite.
  received_at         DateTime?
  /// Quando o responsável informou que concluiu. Não fecha o chamado.
  done_at             DateTime?
  /// O que o responsável escreveu ao concluir — o relatório do serviço. Opcional:
  /// nem toda manutenção tem o que relatar, e exigir texto viraria texto vazio.
  done_report         String?
  /// Quando o moderador fechou. É o único carimbo que conclui de verdade.
  closed_at           DateTime?
  closed_by_id        String?
  /// O que o moderador acrescentou ao chamado — manutenção necessária, combinados.
  maintenance_note    String?
  /// Valor da manutenção, em reais.
  maintenance_cost    Decimal?            @db.Decimal(12, 2)
  created_at          DateTime            @default(now())

  floor_form_entry FloorFormEntry @relation(fields: [floor_form_entry_id], references: [id], onDelete: Cascade)
  responsible_user User?          @relation("RecordResponsible", fields: [responsible_id], references: [id], onDelete: SetNull)
  closed_by        User?          @relation("RecordClosedBy", fields: [closed_by_id], references: [id], onDelete: SetNull)
  updates          TicketUpdate[]

  // As telas de chamado são sempre "um status, do mais novo para o mais velho";
  // a do responsável é "o que é meu", e por isso o id dele também é indexado.
  @@index([status, created_at(sort: Desc)])
  @@index([responsible_id])
  @@map("maintenance_records")
}

/// Uma anotação do andamento da manutenção, no instante em que ela foi escrita.
///
/// Existe porque `done_report` era o único registro do trabalho: um texto só,
/// escrito no fim e sobrescrito a cada edição. Manutenção que leva dias não
/// cabe nele — o que se descobriu na segunda, a peça que chegou na quarta e o
/// teste da sexta viravam um parágrafo ou nada. Aqui cada passo é uma linha
/// com hora própria, e o conjunto é a linha do tempo que o moderador lê antes
/// de fechar.
///
/// Quem escreve é o responsável do chamado ou o moderador do prédio. Alterar
/// vale só para a última linha e só para quem a escreveu: o que já foi lido
/// por outra pessoa não se reescreve, senão o registro deixa de valer como
/// registro.
///
/// O relatório do período não lê esta tabela de propósito — ele resume o que
/// foi gasto e fechado, e o passo a passo da execução é leitura de tela.
model TicketUpdate {
  id        String @id @default(uuid())
  ticket_id String
  author_id String?
  /// Nome de quem escreveu, congelado aqui — como `MaintenanceRecord.responsible`.
  ///
  /// O gestor não está em `users`, então `author_id` fica nulo quando é ele que
  /// escreve; e o vínculo do usuário é SetNull, então a conta pode sumir. Nos
  /// dois casos a linha continua dizendo quem a escreveu.
  author_name String
  description String
  /// URLs públicas das fotos, no bucket de fotos — a mesma casa dos avatares.
  photos      String[]
  created_at  DateTime  @default(now())
  /// Quando o autor corrigiu o texto. Nulo = como foi escrita.
  edited_at   DateTime?

  ticket MaintenanceRecord @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  author User?             @relation("TicketUpdateAuthor", fields: [author_id], references: [id], onDelete: SetNull)

  // A leitura é sempre "a linha do tempo deste chamado, do começo ao fim".
  @@index([ticket_id, created_at])
  @@map("ticket_updates")
}

/// Sugestão que uma conta manda ao admin.
///
/// Quem manda pode ser das duas naturezas — usuário ou gestor —, então a autoria
/// segue o desenho do `AuditLog`: duas colunas nulas, exatamente uma preenchida.
/// Uma coluna só obrigaria a inventar um dono para o outro tipo de conta.
///
/// As duas apontam com `SetNull`: a conta some, o feedback fica. O que o admin
/// tem na caixa de tarefas não pode evaporar porque alguém saiu do sistema.
model Feedback {
  id          String         @id @default(uuid())
  user_id     String?
  manager_id  String?
  message     String
  status      FeedbackStatus @default(PENDENTE)
  created_at  DateTime       @default(now())
  /// Quando o admin decidiu o que fazer com ele. Nulo enquanto está PENDENTE.
  reviewed_at DateTime?

  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  manager Manager? @relation(fields: [manager_id], references: [id], onDelete: SetNull)

  // A tela do admin é sempre "um status, do mais novo para o mais velho".
  @@index([status, created_at(sort: Desc)])
  @@index([user_id])
  @@index([manager_id])
  @@map("feedbacks")
}

model AuditLog {
  id          String      @id @default(uuid())
  // Quem agiu. Exatamente um dos dois é preenchido: a ação partiu de uma conta
  // de usuário ou de uma conta de gestor, e elas vivem em tabelas diferentes.
  user_id     String?
  manager_id  String?
  // Prédio a que o registro pertence, quando houver: é o que permite ao gestor
  // ver a trilha do prédio dele em vez da do sistema inteiro. Login, logout e
  // mexida em conta não têm prédio, e ficam nulos.
  building_id String?
  action      AuditAction
  entity      String?
  entity_id   String?
  metadata    Json?
  timestamp   DateTime    @default(now())

  user     User?     @relation(fields: [user_id], references: [id])
  manager  Manager?  @relation(fields: [manager_id], references: [id], onDelete: SetNull)
  building Building? @relation(fields: [building_id], references: [id], onDelete: SetNull)

  // Toda consulta da trilha é "de um prédio (ou de uma conta), do mais novo para
  // o mais velho". Só por prédio, a ordenação percorria a tabela inteira — e ela
  // ganha uma linha a cada login e nunca perde nenhuma.
  @@index([building_id, timestamp(sort: Desc)])
  @@index([user_id, timestamp(sort: Desc)])
  @@index([manager_id])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PLANOS E COBRANÇA
// ─────────────────────────────────────────────

/// O que a conta de gestor contratou no Stripe.
///
/// Uma por gestor — daí o `@unique` em `manager_id`. Duas assinaturas para a
/// mesma conta não é um estado com significado: seria duas respostas para "qual
/// é o plano dele".
///
/// A assinatura é da conta, e não do prédio: quem paga por um prédio é quem o
/// criou (ver `Building.owner_manager_id`). Assinatura por prédio obrigaria
/// quem tem três a passar três vezes pelo cartão.
///
/// Os ids do Stripe ficam nulos enquanto a assinatura não existir lá — é o caso
/// de quem só tem concessão do admin.
model Subscription {
  id                     String             @id @default(uuid())
  manager_id             String             @unique
  plan                   PlanCode
  status                 SubscriptionStatus
  interval               BillingInterval    @default(MONTHLY)
  /// Prédios comprados além dos inclusos no plano.
  ///
  /// Mora aqui, e não no catálogo, porque é quantidade contratada e muda por
  /// conta; o teto de quanto se pode comprar é que está no código.
  extra_buildings        Int                @default(0)
  stripe_customer_id     String?
  stripe_subscription_id String?            @unique
  /// Até quando o período pago vai.
  current_period_end     DateTime?
  /// Cancelou, mas segue valendo até o fim do período já pago.
  cancel_at_period_end   Boolean            @default(false)
  /// Carimbo de tempo do último evento do Stripe aplicado, para ignorar eventos fora de ordem.
  last_event_at          DateTime?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  manager Manager @relation(fields: [manager_id], references: [id], onDelete: Cascade)

  @@index([stripe_customer_id])
  @@map("subscriptions")
}

/// O plano que o admin liberou para uma conta sem passar pelo Stripe.
///
/// Cortesia, suporte, parceria, teste. A concessão ativa vence a assinatura —
/// é a única forma de o suporte resolver na hora um problema de cobrança sem
/// mexer no que o cliente contratou (ver `planService.resolvePlan`).
///
/// `expires_at` nulo é concessão sem prazo. `revoked_at` é o admin voltando
/// atrás antes do prazo, e a linha fica: saber que alguém teve PRO por duas
/// semanas é o tipo de coisa que se precisa responder depois.
///
/// `reason` é obrigatório de propósito: concessão sem motivo escrito é a que
/// ninguém consegue explicar seis meses depois.
model PlanGrant {
  id         String    @id @default(uuid())
  manager_id String
  plan       PlanCode
  reason     String
  /// Qual conta de admin concedeu. Nulo quando a concessão não partiu de uma
  /// pessoa (o grandfathering da migration) ou quando a conta do admin sumiu.
  granted_by String?
  starts_at  DateTime  @default(now())
  expires_at DateTime?
  revoked_at DateTime?
  created_at DateTime  @default(now())

  manager    Manager @relation(fields: [manager_id], references: [id], onDelete: Cascade)
  granted_by_user User? @relation("PlanGrantedBy", fields: [granted_by], references: [id], onDelete: SetNull)

  // A pergunta é sempre "a concessão que vale para esta conta agora", e a
  // resposta é a mais recente entre as que ainda não venceram.
  @@index([manager_id, created_at(sort: Desc)])
  @@map("plan_grants")
}

/// Os eventos que o Stripe já entregou.
///
/// A chave primária é o id do evento no Stripe, e é só isso que torna o webhook
/// idempotente: o Stripe reentrega o mesmo evento quando não recebe 200, e sem
/// esta tabela o reenvio aplicaria a mesma mudança duas vezes.
///
/// O corpo fica guardado porque é o único registro do que o Stripe disse —
/// quando o banco discordar do painel, é aqui que se descobre qual dos dois
/// lados errou.
model StripeEvent {
  id           String   @id
  type         String
  payload      Json?
  processed_at DateTime @default(now())

  @@index([processed_at(sort: Desc)])
  @@map("stripe_events")
}

/// O que a conta já gastou dos limites que se renovam.
///
/// Uma linha por conta e por mês (`period` em YYYY-MM), porque esses limites
/// viram zero na virada. Um contador corrente exigiria alguém para zerá-lo todo
/// dia 1 — e esse alguém falha.
///
/// O mês é texto e não data de propósito: é uma chave, não um instante.
/// `2026-09` ordena e compara como string, sem ambiguidade de fuso.
///
/// Fotos não contam aqui: elas não viram zero na virada do mês, ficam até
/// alguém apagar. O que está guardado é a soma de `PhotoAsset`.
model UsageCounter {
  id          String   @id @default(uuid())
  manager_id  String
  period      String
  emails_sent Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  manager Manager @relation(fields: [manager_id], references: [id], onDelete: Cascade)

  // Único por conta e mês: é o que permite somar com um upsert, sem ler antes
  // de escrever e sem duas linhas do mesmo mês nascendo em requisições juntas.
  @@unique([manager_id, period])
  @@map("usage_counters")
}

/// Uma foto guardada no bucket, e o espaço que ela ocupa.
///
/// O limite de armazenamento é por conta de gestor, mas a foto pertence ao
/// prédio: quem paga por ela é o dono dele (`Building.owner_manager_id`), e é
/// por esse caminho que a soma é feita. Guardar o gestor aqui também criaria
/// uma segunda verdade sobre de quem é a foto, e ela ficaria velha no dia em
/// que o prédio trocasse de dono.
///
/// `path` é o caminho no bucket, e não a URL — a mesma escolha de
/// `InspectionReport.excel_path`. `bytes` é BigInt porque a soma de uma conta
/// com 150 GB não cabe em Int.
model PhotoAsset {
  id          String   @id @default(uuid())
  building_id String
  path        String   @unique
  bytes       BigInt
  created_at  DateTime @default(now())

  building Building @relation(fields: [building_id], references: [id], onDelete: Cascade)

  @@index([building_id])
  @@map("photo_assets")
}

/// O pedido de troca de dono do prédio.
///
/// Trocar o dono é passar a conta adiante, então não pode ser um clique só de
/// quem sai: o co-gestor indicado recebe uma solicitação de comprometimento e
/// precisa aceitar. Aceite transfere; recusa ou silêncio de sete dias inativa o
/// prédio, e reativar passa pelo admin.
///
/// `status` é texto e não enum, como em `BuildingAccessRequest`: são quatro
/// valores de fluxo (PENDENTE, ACEITO, RECUSADO, EXPIRADO) que o produto ainda
/// pode mexer, e um enum novo por fluxo custa migration a cada ajuste.
///
/// Um pedido de pé por prédio — o índice único parcial está na migration, que é
/// onde ele cabe: o Prisma não modela índice com WHERE.
model BuildingOwnershipTransfer {
  id              String    @id @default(uuid())
  building_id     String
  from_manager_id String
  to_manager_id   String
  status          String    @default("PENDENTE")
  requested_at    DateTime  @default(now())
  /// Sete dias depois do pedido. Passado o prazo sem resposta, o prédio inativa.
  expires_at      DateTime
  /// Quando o indicado respondeu. Nulo enquanto o pedido está de pé.
  responded_at    DateTime?
  created_at      DateTime  @default(now())

  building     Building @relation(fields: [building_id], references: [id], onDelete: Cascade)
  from_manager Manager  @relation("TransferFrom", fields: [from_manager_id], references: [id], onDelete: Cascade)
  to_manager   Manager  @relation("TransferTo", fields: [to_manager_id], references: [id], onDelete: Cascade)

  // A tela do co-gestor é "os pedidos que esperam por mim".
  @@index([to_manager_id, status])
  @@index([building_id])
  @@map("building_ownership_transfers")
}
