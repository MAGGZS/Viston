{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    // Ligado depois que os `as any` das rotas saíram (ver src/types/express.d.ts):
    // eram eles que escondiam o que faltava tipar. Com `strict`, o zod passa a
    // inferir os payloads sozinho — antes, os tipos do envio da vistoria eram
    // escritos à mão porque a inferência marcava todo campo como opcional, e a
    // cópia manual do contrato podia divergir dele em silêncio.
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
